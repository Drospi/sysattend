# ─────────────────────────────────────────────────────────
# SysAttend AI — Variables de Entorno
# Copiar este archivo como .env y ajustar los valores
# ─────────────────────────────────────────────────────────

# Seguridad (CAMBIAR en producción)
SECRET_KEY=sysattend-super-secret-key-cambiar-en-produccion-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos
# SQLite (desarrollo - no requiere instalación)
DATABASE_URL=sqlite:///./sysattend.db

# PostgreSQL (producción - descomentar y configurar)
# DATABASE_URL=postgresql://sysattend:password@localhost:5432/sysattend_db

# CORS - Orígenes permitidos
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Visión Artificial
CONFIDENCE_THRESHOLD=0.75
EMBEDDING_DIM=128
LIVENESS_CHECK=false
SESSION_MAX_MINUTES=30

# Tardanza (minutos de tolerancia)
TARDANZA_TOLERANCIA_MINUTOS=10

# Límite de faltas (% máximo antes de reprobar)
LIMITE_FALTAS_PORCENTAJE=25.0

# Geolocalización del campus (opcional)
GEO_ENABLED=false
CAMPUS_LAT=-16.5000
CAMPUS_LNG=-68.1500
CAMPUS_RADIUS_METERS=500.0

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Notificaciones WhatsApp (opcional - Twilio)
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
